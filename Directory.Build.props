<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>0.3.1</Version>
    <Product>Dilim</Product>
    <Authors>Dilim contributors; Dilim contributors</Authors>
    <Copyright>Copyright (c) 2026 Dilim contributors and Dilim contributors</Copyright>

    <!-- Single source of truth for the GitHub repository (used by the updater and the About page). -->
    <DilimRepositoryUrl Condition="'$(DilimRepositoryUrl)' == ''">https://github.com/h-skycloud/dilim</DilimRepositoryUrl>
    <RepositoryUrl>$(DilimRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>
