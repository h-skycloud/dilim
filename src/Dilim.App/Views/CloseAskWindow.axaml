<!-- Asked when the main window closes while AppSettings.CloseAction is Ask: keep Dilim in the tray or quit, with
     "Don't ask again" (Settings → General changes it later). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="using:Dilim.App.Views.Tools"
        x:Class="Dilim.App.Views.CloseAskWindow"
        Title="Dilim"
        Icon="avares://Dilim/Assets/Icons/dilim.ico"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <tools:CardFrame Title="{DynamicResource close.title}" Scrolls="False">
    <tools:CardFrame.Footer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button MinWidth="88" HorizontalContentAlignment="Center" Content="{DynamicResource common.cancel}"
                Click="OnCancel" IsCancel="True" />
        <Button MinWidth="88" HorizontalContentAlignment="Center" Content="{DynamicResource close.quit}" Click="OnQuit" />
        <Button Classes="accent" MinWidth="88" HorizontalContentAlignment="Center" Content="{DynamicResource close.tray}"
                Click="OnTray" IsDefault="True" />
      </StackPanel>
    </tools:CardFrame.Footer>
    <StackPanel Spacing="14">
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource close.text}" />
      <CheckBox x:Name="DontAsk" Content="{DynamicResource close.dont_ask}" />
    </StackPanel>
  </tools:CardFrame>
</Window>
