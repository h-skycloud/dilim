<!-- The preset popup opened by right-click / ✎ on a donut slice. Same editor as the Presets page. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dilim.App.ViewModels"
        xmlns:views="using:Dilim.App.Views"
        xmlns:tools="using:Dilim.App.Views.Tools"
        x:Class="Dilim.App.Views.PresetEditorWindow"
        x:DataType="vm:PresetEditorViewModel"
        Title="{DynamicResource presets.editor_title}"
        Icon="avares://Dilim/Assets/Icons/dilim.ico"
        Width="560" Height="680" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <tools:CardFrame Title="{DynamicResource presets.editor_title}">
    <tools:CardFrame.Footer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{DynamicResource common.cancel}" Click="OnCancel" IsCancel="True" />
        <Button Classes="accent" Content="{DynamicResource common.save}" Click="OnSave" IsDefault="True" IsEnabled="{Binding IsValid}" />
      </StackPanel>
    </tools:CardFrame.Footer>
    <views:PresetEditorView />
  </tools:CardFrame>
</Window>
