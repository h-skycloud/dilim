// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// DILIM_VERSION_MAJOR/MINOR/PATCH and DILIM_VERSION_TEXT.

#include <winver.h>

#ifndef DILIM_VERSION_MAJOR
#define DILIM_VERSION_MAJOR 0
#define DILIM_VERSION_MINOR 0
#define DILIM_VERSION_PATCH 0
#define DILIM_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION DILIM_VERSION_MAJOR, DILIM_VERSION_MINOR, DILIM_VERSION_PATCH, 0
PRODUCTVERSION DILIM_VERSION_MAJOR, DILIM_VERSION_MINOR, DILIM_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Dilim contributors"
            VALUE "FileDescription", "Dilim File Explorer context menu"
            VALUE "FileVersion", DILIM_VERSION_TEXT
            VALUE "InternalName", "DilimExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) Dilim contributors. MIT License."
            VALUE "OriginalFilename", "DilimExplorerMenu.dll"
            VALUE "ProductName", "Dilim"
            VALUE "ProductVersion", DILIM_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
