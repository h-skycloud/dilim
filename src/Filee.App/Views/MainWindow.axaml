<!-- Main window = settings: navigation on the left, current page on the right. Closing hides to the tray. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Dilim"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="1180" Height="840" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="218,*" RowDefinitions="58,*,30">
    <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://Filee/Assets/Icons/filee.png" Width="28" Height="28" />
          <TextBlock Text="Dilim" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding CaptureStatus}" Classes="caption" Margin="24,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="999" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="EnglishButton" Classes="language" Classes.selected="{Binding IsEnglish}" Content="EN"
                    Command="{Binding ChangeLanguageCommand}" CommandParameter="en" AutomationProperties.Name="English" />
            <Button x:Name="TurkishButton" Classes="language" Classes.selected="{Binding IsTurkish}" Content="TR"
                    Command="{Binding ChangeLanguageCommand}" CommandParameter="tr" AutomationProperties.Name="Türkçe" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <!-- Navigation -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,22,12,12">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource shell.workspace}" Classes="caption" LetterSpacing="1.5" Margin="12,0,0,14" FontSize="10" />
        <!-- Bottom: the running version, and a download button when a newer release is out. -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="4,12,4,0">
          <!-- Accent for required and recommended updates, plain for optional ones; a pill says which -->
          <Button x:Name="UpdateButton" Classes.accent="{Binding !Updates.IsOptional}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                  ToolTip.Tip="{Binding UpdateTip}">
            <DockPanel>
              <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                      Background="{DynamicResource DangerBrush}" IsVisible="{Binding Updates.IsRequired}">
                <TextBlock Text="{DynamicResource update.pill.Required}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
              </Border>
              <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                      Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding Updates.IsOptional}">
                <TextBlock Classes="caption" Text="{DynamicResource update.pill.Optional}" FontSize="11" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
                <TextBlock Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DockPanel>
          </Button>
          <TextBlock x:Name="VersionLabel" Classes="caption" Margin="8,0,0,0" Text="{Binding VersionText}" />
        </StackPanel>
        <ListBox Classes="nav" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Width="17" Height="17" Data="{Binding Icon}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="{Binding PageScroll}">
      <ContentControl Classes="page" Content="{Binding CurrentPage}" Margin="28,24,28,32" MaxWidth="980" HorizontalAlignment="Stretch" />
    </ScrollViewer>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource shell.local}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{DynamicResource shell.source_safe}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
