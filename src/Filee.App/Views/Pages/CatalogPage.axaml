<!-- The catalogue is a working surface: local files, the real front/back donuts and accessible preset buttons. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:app="using:Filee.App.ViewModels"
             xmlns:c="using:Filee.App.Controls"
             x:Class="Filee.App.Views.Pages.CatalogPage"
             x:DataType="vm:CatalogPageViewModel">
  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <ComboBox ItemsSource="{Binding MenuModes}" SelectedItem="{Binding SelectedMode}" MinWidth="160" HorizontalAlignment="Left" />
      <Button Grid.Column="1" Content="{DynamicResource pie.help}" Click="OnHelp" Margin="8,0" />
      <Button Grid.Column="2" Content="{DynamicResource pie.open}" Click="OnOpenPie" Classes="accent" />
    </Grid>
    <ListBox x:Name="CategoryStrip" Classes="categories" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CatalogCategory">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border x:Name="FileDropZone" DragDrop.AllowDrop="True" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18,16">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
        <Border Background="{DynamicResource AccentFaintBrush}" CornerRadius="12" Width="44" Height="44" Margin="0,0,14,0" Grid.RowSpan="2">
          <PathIcon Data="{StaticResource Icon.Upload}" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding SelectionText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
        <TextBlock Grid.Column="1" Grid.Row="1" Text="{DynamicResource catalog.choose_hint}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Top" />
        <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Command="{Binding ClearFilesCommand}" Content="{DynamicResource home.clear_history}" IsVisible="{Binding HasFiles}" Classes="ghost" />
          <Button x:Name="ChooseFilesButton" Click="OnChooseFiles" Content="{DynamicResource catalog.choose_files}" Classes="accent" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Spacing="8">
      <TextBlock Text="{DynamicResource catalog.library}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox ItemsSource="{Binding LibraryPresets}" SelectedItem="{Binding SelectedLibraryPreset}" HorizontalAlignment="Stretch" />
        <Button Grid.Column="1" Content="{DynamicResource catalog.run}" Command="{Binding RunLibraryPresetCommand}" IsEnabled="{Binding HasFiles}" Classes="accent" Margin="8,0,0,0" />
      </Grid>
    </StackPanel>

    <Border x:Name="JobResult" IsVisible="{Binding CurrentJob, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
      <ContentControl Content="{Binding CurrentJob}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="app:JobViewModel">
            <StackPanel Spacing="8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource AccentStrongBrush}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" />
              <TextBlock Text="{Binding ErrorDetails}" Classes="caption danger" TextWrapping="Wrap" IsVisible="{Binding HasErrors}" />
              <TextBlock Text="{Binding Notices}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasNotices}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{DynamicResource toast.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                <Button Content="{DynamicResource home.open_folder}" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasOutputs}" />
                <Button Content="{DynamicResource common.retry}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>

    <Border x:Name="WheelsPanel" Background="{DynamicResource SurfaceBrush}" CornerRadius="22" Padding="20,18" BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding SourceText}" Classes="caption" HorizontalAlignment="Center" />
        <!-- Both previews use the real donut control. Groups open accessible flyouts in this catalogue. -->
        <Grid ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0" Grid.ColumnSpan="{Binding FrontSpan}" Spacing="10">
            <TextBlock Text="{Binding FrontLabel}" Classes="muted" HorizontalAlignment="Center" />
            <Viewbox Stretch="Uniform" MaxHeight="250">
              <c:DonutMenu x:Name="FrontWheel" Items="{Binding FrontItems}" OuterRadius="118" HoleRatio="0.42"
                           CornerRadius="22" CenterTitle="{Binding CenterLabel}" SliceOpacity="1"
                           AllowContextEdit="False" AutomationProperties.Name="{DynamicResource catalog.front}" />
            </Viewbox>
          </StackPanel>
          <Border Grid.Column="1" IsVisible="{Binding HasBack}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}" Padding="12,0,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding BackLabel}" Classes="muted" HorizontalAlignment="Center" />
              <Panel>
                <Viewbox Stretch="Uniform" MaxHeight="250" IsVisible="{Binding HasBack}">
                  <c:DonutMenu x:Name="BackWheel" Items="{Binding BackItems}" OuterRadius="118" HoleRatio="0.42"
                               CornerRadius="22" CenterTitle="{DynamicResource catalog.back_short}" SliceOpacity="1"
                               AllowContextEdit="False" AutomationProperties.Name="{DynamicResource catalog.back}" />
                </Viewbox>
                <TextBlock Text="{DynamicResource catalog.no_back}" Classes="muted" IsVisible="{Binding !HasBack}"
                           Margin="12,90" TextWrapping="Wrap" TextAlignment="Center" />
              </Panel>
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Text="{Binding GestureHint}" Classes="caption" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" Classes="caption danger" TextWrapping="Wrap" />


    <StackPanel Spacing="12">
      <TextBlock Text="{DynamicResource catalog.presets}" Classes="h2" />
      <TextBlock Text="{DynamicResource catalog.presets_hint}" Classes="caption" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Front}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CatalogEntry">
            <Button Classes="catalog-preset" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnPresetClick" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Detail}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Detail}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="caption" MaxWidth="280" TextWrapping="Wrap" Margin="16,0,0,0" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Back}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CatalogEntry">
            <Button Classes="catalog-preset" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnPresetClick" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Detail}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Detail}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="caption" MaxWidth="280" TextWrapping="Wrap" Margin="16,0,0,0" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
